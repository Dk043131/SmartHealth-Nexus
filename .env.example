# SmartHealth Nexus - Global Environment Variables Template

# DATABASE CONFIGURATION
# Set your PostgreSQL URL here. Otherwise, SQLite is used by default.
# DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<db_name>

# Alternative: Dynamic PostgreSQL connection using API Key / Token (for serverless DBs like Supabase, Neon)
# DB_HOST=your-db-host.neon.tech
# DB_PORT=5432
# DB_USER=postgres
# DB_API_KEY=your_postgres_api_key_or_token
# DB_TOKEN=your_postgres_api_key_or_token
# DB_NAME=smarthealth_nexus
# DB_SSL_MODE=require

# SECURITY
JWT_SECRET=your_jwt_secret_key_here
